[MASTER]
init-hook='import sys; sys.path.append("./app")'
load-plugins=pylint.extensions.mccabe,pylint.extensions.bad_builtin

[MESSAGES CONTROL]
disable=
    missing-docstring,
    too-few-public-methods,
    line-too-long,
    import-error,
    no-name-in-module,
    too-many-arguments

enable= 
    unused-import,
    wrong-import-order,
    bad-whitespace,
    trailing-whitespace,
    invalid-name,
    redefined-builtin

[FORMAT]
max-line-length=120

[BASIC]
good-names= 
    db,
    logger,
    app,
    e,
    _
    
[TYPECHECK]
ignored-modules=
    pydantic,
    motor,
    pymongo